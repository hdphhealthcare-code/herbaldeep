PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/fusse_crm
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
SEED_ADMIN_EMAIL=admin@fusemarket.in
SEED_ADMIN_PASSWORD=Admin@123

# Xpressbees shipping API (your Xpressbees panel login; the backend fetches + refreshes the token itself)
XPRESSBEES_BASE_URL=https://shipment.xpressbees.com/api
XPRESSBEES_EMAIL=
XPRESSBEES_PASSWORD=

# Shipmozo shipping API (keys from Shipmozo panel > Profile). Never commit real keys.
SHIPMOZO_BASE_URL=https://shipping-api.com/app/api/v1
SHIPMOZO_PUBLIC_KEY=
SHIPMOZO_PRIVATE_KEY=

# Ekart (client id + login from your Ekart onboarding mail; seller details are mandatory for booking)
EKART_BASE_URL=https://app.elite.ekartlogistics.in
EKART_CLIENT_ID=
EKART_USERNAME=
EKART_PASSWORD=
EKART_SELLER_NAME=
EKART_SELLER_ADDRESS=
EKART_SELLER_GST_TIN=
# GST % used on the shipment when the order has no invoice yet (invoice tax % is used when it has one)
EKART_GST_PERCENT=0
EKART_CATEGORY=Healthcare
EKART_HSN_CODE=
