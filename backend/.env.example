PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/herbaldeep_crm
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
SEED_ADMIN_EMAIL=admin@herbaldeep.in
SEED_ADMIN_PASSWORD=Admin@123

# Xpressbees shipping API (your Xpressbees panel login; the backend fetches + refreshes the token itself)
XPRESSBEES_BASE_URL=https://shipment.xpressbees.com/api
XPRESSBEES_EMAIL=
XPRESSBEES_PASSWORD=

# Shipmozo shipping API (keys from Shipmozo panel > Profile). Never commit real keys.
SHIPMOZO_BASE_URL=https://shipping-api.com/app/api/v1
SHIPMOZO_PUBLIC_KEY=
SHIPMOZO_PRIVATE_KEY=

# Ekart (client id + login from your Ekart onboarding mail; seller details are mandatory for booking)
EKART_BASE_URL=https://app.elite.ekartlogistics.in
EKART_CLIENT_ID=
EKART_USERNAME=
EKART_PASSWORD=
EKART_SELLER_NAME=
EKART_SELLER_ADDRESS=
EKART_SELLER_GST_TIN=
# GST % used on the shipment when the order has no invoice yet (invoice tax % is used when it has one)
EKART_GST_PERCENT=0
EKART_CATEGORY=Healthcare
EKART_HSN_CODE=

# Live status: the server asks the couriers about every booked, unfinished shipment this often (min 30 seconds)
TRACKING_SYNC_ENABLED=true
TRACKING_SYNC_INTERVAL_SEC=120

# Optional: courier webhooks (instant updates). Point the courier at
#   POST https://<your-api>/api/webhooks/<xpressbees|shipmozo|ekart|delhivery|shiprocket>?token=<this secret>
WEBHOOK_SECRET=

# Brand shown on labels and invoices
BRAND_NAME=Herbal Deep

# ---- Delhivery (Express / B2C API) ----
# Token: Delhivery One > Settings > API Setup. It works with ONE server only:
#   production token -> https://track.delhivery.com      staging (testing) token -> https://staging-express.delhivery.com
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_API_TOKEN=
# Optional: your Delhivery client name (only if rate quotes ask for it) and the HSN code printed on shipments
DELHIVERY_CLIENT_NAME=
DELHIVERY_HSN_CODE=

# ---- Shiprocket (API v1) ----
# Create an API user in Shiprocket > Settings > API > Configure > Create API User, and use ITS email + password here
# (the main account login does not work for the API). Wallet balance is needed to book.
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Optional: contact email for new pickup addresses, email used when a customer has none, HSN printed on shipments
SHIPROCKET_PICKUP_EMAIL=
SHIPROCKET_CUSTOMER_EMAIL=
SHIPROCKET_HSN_CODE=
